cabal-version:      3.0
name:               haskell-either-error-propagation-debug-lab
version:            0.1.0.0
synopsis:           Reproducible Either error propagation debugging lab
category:           Education
build-type:         Simple
license:            BSD-3-Clause

library
  exposed-modules:    PortConfig
  hs-source-dirs:     src
  build-depends:      base >=4.17 && <4.18
  default-language:   Haskell2010
  ghc-options:        -Wall

test-suite spec
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  hs-source-dirs:     test
  build-depends:
      base >=4.17 && <4.18
    , hspec >=2.10 && <2.11
    , QuickCheck >=2.14 && <2.15
    , haskell-either-error-propagation-debug-lab
  default-language:   Haskell2010
  ghc-options:        -Wall
